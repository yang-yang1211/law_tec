    {
      "id": "law-tw-civil-code-art-429-430-repairs",
      "recordType": "regulation",
      "title": "民法",
      "summary": "除租約另有約定或另有習慣外，租賃物修繕原則由出租人負擔。若屬出租人負責的修繕，承租人應先定相當期限催告；逾期未修繕時，得終止契約或自行修繕並請求償還費用，或從租金扣除。",
      "topicTags": [
        "租屋權益"
      ],
      "audienceTags": [
        "租屋族"
      ],
      "billStage": null,
      "legalEffect": "effective",
      "sourceStatusText": null,
      "meetingStatus": null,
      "publishedAt": null,
      "updatedAt": null,
      "meetingDate": null,
      "source": {
        "accessedAt": "2026-11-23T01:49:38+08:00",
        "organization": "法務部全國法規資料庫",
        "citationLocator": "全法修正日期 2026-08-17（非第429、430條個別修正日期）；第429、430條",
        "publishedAt": null,
        "url": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=B0000001",
        "documentTitle": "民法",
        "publishedDate": "2026-08-17"
      },
      "sourceExcerpt": "第429條分配修繕責任；第430條規定催告後仍未修繕時，承租人可終止或自修後請款／扣租。",
      "verificationStatus": "needs_review",
      "verifiedAt": null,
      "verifiedBy": null,
      "notificationLevel": "none"
    },
    {
      "id": "law-tw-residential-lease-no-rent-subsidy-ban",
      "recordType": "regulation",
      "title": "內政部公告：修正「住宅租賃定型化契約應記載及不得記載事項」不得記載事項第10點規定，自即日生效",
      "summary": "住宅租賃定型化契約不得約定承租人不得申請租金補貼；出租人不得以明文條款禁止或以不當約款限制承租人提出申請。此修正自2023-06-14公告生效。",
